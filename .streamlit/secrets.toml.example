# Streamlit Secrets Configuration Example
# Copy this file to .streamlit/secrets.toml and fill in your values
# For Streamlit Cloud, set these as secrets in the dashboard

# Backend API URL (optional, can also be set via environment variable)
API_BASE_URL = "https://your-app.vercel.app"

# Admin Secret (for executing trades - keep secure!)
ADMIN_SECRET = "your-admin-secret-here"

