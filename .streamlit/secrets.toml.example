# Streamlit Secrets Configuration Example
# Copy this file to .streamlit/secrets.toml and fill in your values
# For Streamlit Cloud, set these as secrets in the dashboard

# Backend API URL (required for Streamlit Cloud)
# Options:
# - Local development: http://localhost:8000
# - Cloudflare Tunnel: https://your-tunnel-url.trycloudflare.com
# - Other backend: https://your-backend-url.com
API_BASE_URL = "http://localhost:8000"

# Admin Secret (for executing trades - keep secure!)
# Get this from your backend .env file (ADMIN_SECRET)
ADMIN_SECRET = "your-admin-secret-here"

