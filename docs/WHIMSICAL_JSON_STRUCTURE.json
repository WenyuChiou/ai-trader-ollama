  "connections": [
    {"from": "goal", "to": "market_agent"},
    {"from": "market_agent", "to": "market_data"},
    {"from": "market_data", "to": "market_analyst"},
    {"from": "market_analyst", "to": "market_analysis"},
    {"from": "market_analysis", "to": "analyst_discussion"},
    {"from": "analyst_discussion", "to": "discussion_consensus", "type": "loop"},
    {"from": "discussion_consensus", "to": "risk_analyst"},
    {"from": "market_data", "to": "risk_analyst"},
    {"from": "market_analysis", "to": "risk_analyst"},
    {"from": "portfolio", "to": "risk_analyst", "bidirectional": true},
    {"from": "risk_analyst", "to": "risk_report"},
    {"from": "risk_report", "to": "trader_agent"},
    {"from": "discussion_consensus", "to": "trader_agent"},
    {"from": "market_data", "to": "trader_agent"},
    {"from": "market_analysis", "to": "trader_agent"},
    {"from": "trader_agent", "to": "trading_decision"},
    {"from": "trading_decision", "to": "execution"},
    {"from": "execution", "to": "backend_display"},
    {"from": "backend_display", "to": "evaluation"},
    {"from": "evaluation", "to": "market_agent", "type": "feedback"}
  ],
  "groups": [
    {
      "name": "Data Collection Layer",
      "nodes": ["market_agent", "market_data"]
    },
    {
      "name": "Analysis Layer",
      "nodes": ["market_analyst", "market_analysis", "analyst_discussion", "discussion_consensus"]
    },
    {
      "name": "Risk Management Layer",
      "nodes": ["risk_analyst", "portfolio", "risk_report"]
    },
    {
      "name": "Decision Layer",
      "nodes": ["trader_agent", "trading_decision"]
    },
    {
      "name": "Execution Layer",
      "nodes": ["execution"]
    },
    {
      "name": "Display Layer",
      "nodes": ["backend_display"]
    }
  ]
}

